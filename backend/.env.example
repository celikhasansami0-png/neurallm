# Postgres connection string (Supabase provides this under Project Settings -> Database)
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres
# Supabase project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Supabase service role key (Project Settings -> API -> service_role secret)
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key
# Composio API key (https://app.composio.dev/settings)
COMPOSIO_API_KEY=your-composio-api-key
# Secret used to sign JWTs - generate with `openssl rand -hex 32`
SECRET_KEY=change-me-to-a-random-64-char-hex-string
# URL of the deployed frontend (used for CORS, and for building links in emails/checkout redirects)
FRONTEND_URL=https://neurallm.vercel.app

# --- Stripe billing (optional) ---
# Without these, the app runs fine but /api/v1/billing/* endpoints return a clear 503 instead
# of crashing, and the Settings page's upgrade buttons won't complete checkout.
# Stripe secret key (https://dashboard.stripe.com/apikeys) - powers checkout session creation.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Stripe webhook signing secret (Stripe Dashboard -> Developers -> Webhooks) - powers /api/v1/billing/webhook.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# Stripe Price ID for the "Team" plan ($299/mo) - powers the Team upgrade button.
STRIPE_PRICE_TEAM=price_your_team_plan_price_id
# Stripe Price ID for the "Business" plan ($799/mo) - powers the Business upgrade button.
STRIPE_PRICE_BUSINESS=price_your_business_plan_price_id

# --- SMTP email (optional) ---
# Without these, emails (verification links, password reset links) are simply logged at
# INFO level instead of actually sent - everything else keeps working.
# SMTP server hostname, e.g. smtp.sendgrid.net or smtp.gmail.com
SMTP_HOST=smtp.example.com
# SMTP server port (587 for STARTTLS is typical)
SMTP_PORT=587
# SMTP auth username
SMTP_USER=your-smtp-username
# SMTP auth password / API key
SMTP_PASSWORD=your-smtp-password
